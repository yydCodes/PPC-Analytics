            </a>
        </div>
    </div>

@section Scripts {
<script>
    // Cache for API responses
    const draftMonthsCache = {};
    const approvedMonthsCache = {};

    // Generic function to load draft months
    async function loadDraftMonths(modalId, yearSelectClass, monthSelectClass) {
        const yearSelect = document.querySelector(`#${modalId} .${yearSelectClass}`);
        const monthSelect = document.querySelector(`#${modalId} .${monthSelectClass}`);
        const noPayrollMessage = monthSelect.parentElement.querySelector('.no-draft-message');
        const year = yearSelect.value;

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (draftMonthsCache[year]) {
            populateMonths(monthSelect, draftMonthsCache[year], noPayrollMessage, 'No draft payroll', 'first');
            updateModalSubmitButton(modalId);
            return;
        }

        try {
            const response = await fetch(`/Home/GetDraftMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                draftMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No draft payroll', 'first');
            } else {
                monthSelect.innerHTML = '<option value="">Error</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error</option>';
        }

        updateModalSubmitButton(modalId);
    }

    // Generic function to load approved months (selects LATEST available month)
    async function loadApprovedMonths(modalId, yearSelectClass, monthSelectClass) {
        const yearSelect = document.querySelector(`#${modalId} .${yearSelectClass}`);
        const monthSelect = document.querySelector(`#${modalId} .${monthSelectClass}`);
        const noPayrollMessage = monthSelect.parentElement.querySelector('.no-approved-message');
        const year = yearSelect.value;

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (approvedMonthsCache[year]) {
            populateMonths(monthSelect, approvedMonthsCache[year], noPayrollMessage, 'No approved payroll', 'latest');
            updateModalSubmitButton(modalId);
            return;
        }

        try {
            const response = await fetch(`/Home/GetApprovedMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                approvedMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No approved payroll', 'latest');
            } else {
                monthSelect.innerHTML = '<option value="">Error</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error</option>';
        }

        updateModalSubmitButton(modalId);
    }

    // Populate month dropdown
    // defaultSelection: 'first' = select first/earliest month, 'latest' = select last/latest month
    function populateMonths(monthSelect, months, noPayrollMessage, emptyMessage, defaultSelection = 'latest') {
        monthSelect.innerHTML = '';

        if (months.length === 0) {
            monthSelect.innerHTML = `<option value="">${emptyMessage}</option>`;
            monthSelect.disabled = true;
            noPayrollMessage.style.display = 'block';
        } else {
            months.forEach((month, index) => {
                const option = document.createElement('option');
                option.value = month.value;
                option.textContent = month.name;
                
                // Select first or latest month based on defaultSelection parameter
                if (defaultSelection === 'first' && index === 0) {
                    option.selected = true;
                } else if (defaultSelection === 'latest' && index === months.length - 1) {
                    option.selected = true;
                }
                
                monthSelect.appendChild(option);
            });
            monthSelect.disabled = false;
            noPayrollMessage.style.display = 'none';
        }
    }

    // Update submit button state for each modal
    function updateModalSubmitButton(modalId) {
        let submitBtn, draftMonth, approvedMonth;

        if (modalId === 'comparisonModal') {
            submitBtn = document.getElementById('comparisonSubmit');
            draftMonth = document.querySelector('#comparisonModal .comparison-draft-month');
            approvedMonth = document.querySelector('#comparisonModal .comparison-approved-month');
        } else if (modalId === 'differencesModal') {
            submitBtn = document.getElementById('differencesSubmit');
            draftMonth = document.querySelector('#differencesModal .differences-draft-month');
            approvedMonth = document.querySelector('#differencesModal .differences-approved-month');
        } else if (modalId === 'anomalyModal') {
            submitBtn = document.getElementById('anomalySubmit');
            draftMonth = document.querySelector('#anomalyModal .anomaly-draft-month');
            approvedMonth = document.querySelector('#anomalyModal .anomaly-comparison-month');
        }

        const draftValid = draftMonth && draftMonth.value && !draftMonth.disabled;
        const approvedValid = approvedMonth && approvedMonth.value && !approvedMonth.disabled;
        
        submitBtn.disabled = !(draftValid && approvedValid);
    }

    // ========== QUICK PREVIEW FUNCTIONS ==========
    async function loadQuickPreview() {
        const loadingEl = document.getElementById('previewLoading');
        const errorEl = document.getElementById('previewError');
        const errorMsgEl = document.getElementById('previewErrorMessage');
        const dataEl = document.getElementById('previewData');
        
        // Show loading state
        loadingEl.style.display = 'block';
        errorEl.style.display = 'none';
        dataEl.style.display = 'none';
        
        try {
            const response = await fetch('/Home/GetQuickPreview');
            const data = await response.json();
            
            if (!data.success) {
                // Show error state
                loadingEl.style.display = 'none';
                errorEl.style.display = 'block';
                errorMsgEl.textContent = data.message || 'Unable to load preview.';
                return;
            }
            
            // Populate preview data
            document.getElementById('previewDraftPeriod').textContent = data.draftPeriod;
            document.getElementById('previewApprovedPeriod').textContent = data.approvedPeriod;
            document.getElementById('previewSummary').textContent = data.summary;
            
            // Confidence badge
            const confidenceBadge = document.getElementById('previewConfidence');
            const confidenceColors = { high: 'bg-success', medium: 'bg-warning', low: 'bg-secondary' };
            const level = data.confidence_level || 'medium';
            confidenceBadge.className = `badge ${confidenceColors[level] || 'bg-secondary'}`;
            confidenceBadge.textContent = `${level.charAt(0).toUpperCase() + level.slice(1)} confidence`;
            
            // Key changes (simple string array)
            const changesEl = document.getElementById('previewChanges');
            if (data.key_changes && data.key_changes.length > 0) {
                let changesHtml = '<ul class="list-unstyled mb-0">';
                data.key_changes.forEach(change => {
                    changesHtml += `<li class="small mb-1"><i class="fas fa-circle text-primary me-2" style="font-size: 6px; vertical-align: middle;"></i>${change}</li>`;
                });
                changesHtml += '</ul>';
                changesEl.innerHTML = changesHtml;
            } else {
                changesEl.innerHTML = '<p class="text-muted small mb-0"><i class="fas fa-check-circle text-success me-1"></i>No significant changes detected.</p>';
            }
            
            // Suggested actions (simple string array)
            const actionsSection = document.getElementById('suggestedActionsSection');
            const actionsList = document.getElementById('suggestedActionsList');
            if (data.suggested_actions && data.suggested_actions.length > 0) {
                let actionsHtml = '';
                data.suggested_actions.forEach(action => {
                    actionsHtml += `
                        <div class="list-group-item d-flex align-items-center py-2 px-0 border-0">
                            <i class="fas fa-arrow-right text-muted me-2" style="font-size: 10px;"></i>
                            <span class="small">${action}</span>
                        </div>
                    `;
                });
                actionsList.innerHTML = actionsHtml;
                actionsSection.style.display = 'block';
            } else {
                actionsSection.style.display = 'none';
            }
            
            // Show data
            loadingEl.style.display = 'none';
            dataEl.style.display = 'block';
            
        } catch (error) {
            console.error('Error loading quick preview:', error);
            loadingEl.style.display = 'none';
            errorEl.style.display = 'block';
            errorMsgEl.textContent = 'Unable to connect to the server.';
        }
    }

    // Initialize event listeners
    document.addEventListener('DOMContentLoaded', function() {
        
        // ========== LOAD QUICK PREVIEW ==========
        loadQuickPreview();
        
        // Refresh button
        document.getElementById('refreshPreview').addEventListener('click', function() {
            loadQuickPreview();
        });
        
        // ========== COMPARISON MODAL ==========
        document.getElementById('comparisonModal').addEventListener('show.bs.modal', function() {
            loadDraftMonths('comparisonModal', 'comparison-draft-year', 'comparison-draft-month');
            loadApprovedMonths('comparisonModal', 'comparison-approved-year', 'comparison-approved-month');
        });

        document.querySelector('#comparisonModal .comparison-draft-year').addEventListener('change', function() {
            loadDraftMonths('comparisonModal', 'comparison-draft-year', 'comparison-draft-month');
        });

        document.querySelector('#comparisonModal .comparison-approved-year').addEventListener('change', function() {
            loadApprovedMonths('comparisonModal', 'comparison-approved-year', 'comparison-approved-month');
        });

