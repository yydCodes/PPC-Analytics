@{
    ViewData["Title"] = "Payroll Intelligence Assistant";
    var currentYear = DateTime.Now.Year;
}

<div class="container mt-4">
    <!-- Page Introduction -->
    <div class="alert alert-light border mb-4">
        <h5 class="alert-heading mb-2"><i class="fas fa-clipboard-check text-primary me-2"></i>Payroll Review Dashboard</h5>
        <p class="mb-0">
            This tool helps payroll administrators and finance reviewers verify draft payrolls before approval.
            It compares your current draft against the last approved period to surface changes that need attention.
            <strong>Start with the Quick Preview below</strong>, then drill into specific features for details.
        </p>
    </div>

    <!-- Quick Preview Section -->
    <div id="quickPreviewSection" class="mb-4">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Preview</h5>
                <button class="btn btn-sm btn-outline-light" id="refreshPreview" title="Refresh preview">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            <div class="card-body" id="quickPreviewContent">
                <!-- Loading state -->
                <div id="previewLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Loading payroll preview...</p>
                </div>
                
                <!-- Error/Not configured state (hidden by default) -->
                <div id="previewError" class="text-center py-4" style="display: none;">
                    <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                    <p class="text-muted mb-2" id="previewErrorMessage">Unable to load preview.</p>
                    <a href="/Home/Settings" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-cog"></i> Configure API Settings
                    </a>
                </div>
                
                <!-- Preview content (hidden by default, populated via JS) -->
                <div id="previewData" style="display: none;">
                    <!-- Period info -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <small class="text-muted">
                            <i class="fas fa-file-alt me-1"></i><span id="previewDraftPeriod"></span>
                            <span class="mx-1">vs</span>
                            <i class="fas fa-check-circle me-1"></i><span id="previewApprovedPeriod"></span>
                        </small>
                        <span class="badge" id="previewConfidence"></span>
                    </div>
                    
                    <!-- Summary (one sentence) -->
                    <p class="mb-3" id="previewSummary"></p>
                    
                    <!-- Key Changes -->
                    <div class="mb-3">
                        <h6 class="text-muted small mb-2">Key Changes</h6>
                        <div id="previewChanges"></div>
                    </div>
                    
                    <!-- Suggested Actions -->
                    <div id="suggestedActionsSection" style="display: none;">
                        <h6 class="text-muted small mb-2">Suggested Actions</h6>
                        <div id="suggestedActionsList" class="list-group list-group-flush"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Period Selection Modal (for Comparison) -->
<div class="modal fade" id="comparisonModal" tabindex="-1" aria-labelledby="comparisonModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="comparisonModalLabel"><i class="fas fa-chart-line"></i> Select Payroll Periods to Compare</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/Home/Comparison" id="comparisonForm">
                <div class="modal-body">
                    <div class="row">
                        <!-- Draft Payroll (Status 0) - Current -->
                        <div class="col-md-6">
                            <div class="card border-primary h-100">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="fas fa-file-alt"></i> Draft Payroll (Current)</h6>
                                    <small class="opacity-75">Status: Draft (0)</small>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Year</label>
                                        <select class="form-control comparison-draft-year" name="draftYear" required>
                                            @for (int y = currentYear; y >= 2022; y--)
                                            {
                                                <option value="@y">@y</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Month</label>
                                        <select class="form-control comparison-draft-month" name="draftMonth" required disabled>
                                            <option value="">Loading...</option>
                                        </select>
                                        <div class="no-draft-message text-danger mt-1" style="display:none;">
                                            <small><i class="fas fa-exclamation-circle"></i> No draft payroll available.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Approved Payroll (Status 2) - Previous -->
                        <div class="col-md-6">
                            <div class="card border-success h-100">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0"><i class="fas fa-check-circle"></i> Approved Payroll (Previous)</h6>
                                    <small class="opacity-75">Status: Approved (2)</small>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Year</label>
                                        <select class="form-control comparison-approved-year" name="comparisonYear" required>
                                            @for (int y = currentYear; y >= 2022; y--)
                                            {
                                                <option value="@y">@y</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Month</label>
                                        <select class="form-control comparison-approved-month" name="comparisonMonth" required disabled>
                                            <option value="">Loading...</option>
                                        </select>
                                        <div class="no-approved-message text-danger mt-1" style="display:none;">
                                            <small><i class="fas fa-exclamation-circle"></i> No approved payroll available.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        <small><i class="fas fa-info-circle"></i> Compare your <strong>draft payroll</strong> (current) against a selected <strong>approved payroll</strong> (previous) to identify changes.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="comparisonSubmit" disabled>
                        <i class="fas fa-chart-line"></i> Run Comparison
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Differences Modal -->
