    <!-- Feature Cards -->
    <h6 class="text-muted mb-3"><i class="fas fa-tools me-1"></i>Analysis Tools</h6>
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
