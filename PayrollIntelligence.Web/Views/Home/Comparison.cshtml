@model PayrollIntelligence.Core.PayrollComparisonResult?

@{
    ViewData["Title"] = "Payroll Summary";
    var currentYear = DateTime.Now.Year;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Payroll Summary</li>
        </ol>
    </nav>

    <!-- Selection Modal -->
    <div class="modal fade" id="periodSelectionModal" tabindex="-1" aria-labelledby="periodSelectionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="periodSelectionModalLabel"><i class="fas fa-chart-line"></i> Select Payroll Periods to Compare</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" id="comparisonForm">
                    <div class="modal-body">
                        <div class="row">
                            <!-- Draft Payroll (Status 0) - Current -->
                            <div class="col-md-6">
                                <div class="card border-primary h-100">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0"><i class="fas fa-file-alt"></i> Draft Payroll (Current)</h6>
                                        <small class="opacity-75">Status: Draft (0)</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Year</label>
                                            <select class="form-control" name="draftYear" id="draftYear" required>
                                                @for (int y = currentYear; y >= 2022; y--)
                                                {
                                                    <option value="@y">@y</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Month</label>
                                            <select class="form-control" name="draftMonth" id="draftMonth" required disabled>
                                                <option value="">Loading...</option>
                                            </select>
                                            <div class="no-draft-message text-danger mt-1" style="display:none;">
                                                <small><i class="fas fa-exclamation-circle"></i> No draft payroll available.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Approved Payroll (Status 2) - Previous -->
                            <div class="col-md-6">
                                <div class="card border-success h-100">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0"><i class="fas fa-check-circle"></i> Approved Payroll (Previous)</h6>
                                        <small class="opacity-75">Status: Approved (2)</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Year</label>
                                            <select class="form-control" name="comparisonYear" id="comparisonYear" required>
                                                @for (int y = currentYear; y >= 2022; y--)
                                                {
                                                    <option value="@y">@y</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Month</label>
                                            <select class="form-control" name="comparisonMonth" id="comparisonMonth" required disabled>
                                                <option value="">Loading...</option>
                                            </select>
                                            <div class="no-approved-message text-danger mt-1" style="display:none;">
                                                <small><i class="fas fa-exclamation-circle"></i> No approved payroll available.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3 mb-0">
                            <small><i class="fas fa-info-circle"></i> Compare your <strong>draft payroll</strong> (current) against a selected <strong>approved payroll</strong> (previous) to identify changes.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                            <i class="fas fa-chart-line"></i> Run Comparison
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-chart-line"></i> Payroll Summary</h4>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#periodSelectionModal">
                        <i class="fas fa-cog"></i> Change Periods
                    </button>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.DraftPeriod) && !string.IsNullOrEmpty(ViewBag.ComparisonPeriod))
                    {
                        <div class="alert alert-info mb-3">
                            <strong><i class="fas fa-file-alt"></i> Draft:</strong> @ViewBag.DraftPeriod
                            <span class="mx-3">→</span>
                            <strong><i class="fas fa-check-circle"></i> Compared against:</strong> @ViewBag.ComparisonPeriod (Approved)
                        </div>

                        <!-- Page Context Help -->
                        <div class="alert alert-light border mb-4">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <strong>What you're looking at:</strong> This page provides a high-level comparison of total payroll costs, headcount, and key metrics between periods.
                            It's designed for finance managers and executives who need to understand overall payroll trends.
                            <strong>Focus on the headline summary</strong> for the main takeaway, then review key drivers for context.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5><i class="fas fa-exclamation-triangle"></i> Analysis Error</h5>
                            <p class="mb-0">@ViewBag.Error</p>
                        </div>
                    }
                    else if (Model != null)
                    {
                        var directionClass = Model.Direction switch
                        {
                            "increase" => "success",
                            "decrease" => "danger",
                            _ => "secondary"
                        };
                        var directionIcon = Model.Direction switch
                        {
                            "increase" => "fa-arrow-trend-up",
                            "decrease" => "fa-arrow-trend-down",
                            _ => "fa-minus"
                        };
                        var confidenceClass = Model.ConfidenceLevel switch
                        {
                            "high" => "success",
                            "medium" => "warning",
                            _ => "secondary"
                        };

                        <!-- Direction Badge & Headline Summary -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="d-flex align-items-center mb-3">
                                    <span class="badge bg-@directionClass fs-5 me-3 p-2">
                                        <i class="fas @directionIcon me-1"></i>
                                        @Model.Direction.ToUpper()
                                    </span>
                                    <span class="badge bg-@confidenceClass">
                                        <i class="fas fa-shield-alt me-1"></i>
                                        @Model.ConfidenceLevel.ToUpper() CONFIDENCE
                                    </span>
                                </div>
                                <p class="lead mb-0">@Model.HeadlineSummary</p>
                            </div>
                        </div>

                        <!-- Metrics Comparison Table -->
                        @if (Model.PreviousMetrics != null && Model.CurrentMetrics != null)
                        {
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5><i class="fas fa-table me-2"></i>Metrics Comparison</h5>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Metric</th>
                                                    <th class="text-end">@Model.PreviousMetrics.PeriodName</th>
                                                    <th class="text-end">@Model.CurrentMetrics.PeriodName</th>
                                                    <th class="text-end">Change</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><strong>Net Pay</strong></td>
                                                    <td class="text-end">RM @Model.PreviousMetrics.NetPay.ToString("N2")</td>
                                                    <td class="text-end">RM @Model.CurrentMetrics.NetPay.ToString("N2")</td>
                                                    <td class="text-end @((Model.CurrentMetrics.NetPay - Model.PreviousMetrics.NetPay) >= 0 ? "text-success" : "text-danger")">
                                                        @((Model.CurrentMetrics.NetPay - Model.PreviousMetrics.NetPay) >= 0 ? "+" : "")RM @((Model.CurrentMetrics.NetPay - Model.PreviousMetrics.NetPay).ToString("N2"))
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Gross Pay</strong></td>
                                                    <td class="text-end">RM @Model.PreviousMetrics.GrossPay.ToString("N2")</td>
                                                    <td class="text-end">RM @Model.CurrentMetrics.GrossPay.ToString("N2")</td>
                                                    <td class="text-end @((Model.CurrentMetrics.GrossPay - Model.PreviousMetrics.GrossPay) >= 0 ? "text-success" : "text-danger")">
                                                        @((Model.CurrentMetrics.GrossPay - Model.PreviousMetrics.GrossPay) >= 0 ? "+" : "")RM @((Model.CurrentMetrics.GrossPay - Model.PreviousMetrics.GrossPay).ToString("N2"))
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Employer Cost</strong></td>
                                                    <td class="text-end">RM @Model.PreviousMetrics.EmployerCost.ToString("N2")</td>
                                                    <td class="text-end">RM @Model.CurrentMetrics.EmployerCost.ToString("N2")</td>
                                                    <td class="text-end @((Model.CurrentMetrics.EmployerCost - Model.PreviousMetrics.EmployerCost) >= 0 ? "text-success" : "text-danger")">
                                                        @((Model.CurrentMetrics.EmployerCost - Model.PreviousMetrics.EmployerCost) >= 0 ? "+" : "")RM @((Model.CurrentMetrics.EmployerCost - Model.PreviousMetrics.EmployerCost).ToString("N2"))
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Headcount</strong></td>
                                                    <td class="text-end">@Model.PreviousMetrics.Headcount</td>
                                                    <td class="text-end">@Model.CurrentMetrics.Headcount</td>
                                                    <td class="text-end @((Model.CurrentMetrics.Headcount - Model.PreviousMetrics.Headcount) >= 0 ? "text-success" : "text-danger")">
                                                        @((Model.CurrentMetrics.Headcount - Model.PreviousMetrics.Headcount) >= 0 ? "+" : "")@(Model.CurrentMetrics.Headcount - Model.PreviousMetrics.Headcount)
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <!-- Key Drivers -->
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-primary">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0"><i class="fas fa-key me-2"></i>Key Drivers</h6>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.KeyDrivers.Any())
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var driver in Model.KeyDrivers)
                                                {
                                                    <li class="mb-2">
                                                        <i class="fas fa-chevron-right text-primary me-2"></i>
                                                        @driver
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">No significant drivers identified.</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Notable Observations -->
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-info">
                                    <div class="card-header bg-info text-white">
                                        <h6 class="mb-0"><i class="fas fa-eye me-2"></i>Notable Observations</h6>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.NotableObservations.Any())
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var observation in Model.NotableObservations)
                                                {
                                                    <li class="mb-2">
                                                        <i class="fas fa-lightbulb text-warning me-2"></i>
                                                        @observation
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">No notable observations.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Suggested Review Actions -->
                        @if (Model.KeyDrivers.Any() || Model.NotableObservations.Any())
                        {
                            <div class="card mt-4 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Suggested Next Steps</h6>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-3">These are optional review actions to consider:</p>
                                    <ul class="list-group list-group-flush">
                                        @if (Model.Direction != "stable")
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-primary me-3 mt-1">1</span>
                                                <div>
                                                    <strong>Understand the @Model.Direction</strong>
                                                    <p class="mb-0 text-muted small">Review the key drivers above to confirm the payroll @Model.Direction aligns with expected business changes.</p>
                                                </div>
                                            </li>
                                        }
                                        @if (Model.CurrentMetrics != null && Model.PreviousMetrics != null && Model.CurrentMetrics.Headcount != Model.PreviousMetrics.Headcount)
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-info text-white me-3 mt-1">@(Model.Direction != "stable" ? "2" : "1")</span>
                                                <div>
                                                    <strong>Verify headcount changes</strong>
                                                    <p class="mb-0 text-muted small">Confirm employee additions or removals are properly documented.</p>
                                                </div>
                                            </li>
                                        }
                                        @if (Model.NotableObservations.Any(o => o.Contains("warning") || o.Contains("error")))
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-warning text-dark me-3 mt-1">3</span>
                                                <div>
                                                    <strong>Check calculation warnings</strong>
                                                    <p class="mb-0 text-muted small">Investigate any payroll calculation warnings noted in observations.</p>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <h5><i class="fas fa-info-circle"></i> No Analysis Results</h5>
                            <p class="mb-0">Please select payroll periods to compare using the button above.</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="/" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Home</a>
                    <button type="button" class="btn btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#periodSelectionModal">
                        <i class="fas fa-sync"></i> New Comparison
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const draftMonthsCache = {};
    const approvedMonthsCache = {};

    async function loadDraftMonths(year) {
        const monthSelect = document.getElementById('draftMonth');
        const noPayrollMessage = document.querySelector('.no-draft-message');

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (draftMonthsCache[year]) {
            populateMonths(monthSelect, draftMonthsCache[year], noPayrollMessage, 'No draft payroll', 'first');
            updateSubmitButton();
            return;
        }

        try {
            const response = await fetch(`/Home/GetDraftMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                draftMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No draft payroll', 'first');
            } else {
                monthSelect.innerHTML = '<option value="">Error loading months</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error loading months</option>';
        }

        updateSubmitButton();
    }

    async function loadApprovedMonths(year) {
        const monthSelect = document.getElementById('comparisonMonth');
        const noPayrollMessage = document.querySelector('.no-approved-message');

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (approvedMonthsCache[year]) {
            populateMonths(monthSelect, approvedMonthsCache[year], noPayrollMessage, 'No approved payroll', 'latest');
            updateSubmitButton();
            return;
        }

        try {
            const response = await fetch(`/Home/GetApprovedMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                approvedMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No approved payroll', 'latest');
            } else {
                monthSelect.innerHTML = '<option value="">Error loading months</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error loading months</option>';
        }

        updateSubmitButton();
    }

    // Populate month dropdown
    // defaultSelection: 'first' = select first/earliest month, 'latest' = select last/latest month
    function populateMonths(monthSelect, months, noPayrollMessage, noDataMessage, defaultSelection = 'latest') {
        monthSelect.innerHTML = '';

        if (months.length === 0) {
            monthSelect.innerHTML = `<option value="">${noDataMessage}</option>`;
            monthSelect.disabled = true;
            noPayrollMessage.style.display = 'block';
        } else {
            months.forEach((month, index) => {
                const option = document.createElement('option');
                option.value = month.value;
                option.textContent = month.name;
                
                // Select first or latest month based on defaultSelection parameter
                if (defaultSelection === 'first' && index === 0) {
                    option.selected = true;
                } else if (defaultSelection === 'latest' && index === months.length - 1) {
                    option.selected = true;
                }
                
                monthSelect.appendChild(option);
            });
            monthSelect.disabled = false;
            noPayrollMessage.style.display = 'none';
        }
    }

    function updateSubmitButton() {
        const submitBtn = document.getElementById('submitBtn');
        const draftMonth = document.getElementById('draftMonth');
        const comparisonMonth = document.getElementById('comparisonMonth');

        const allValid = draftMonth.value && !draftMonth.disabled &&
                         comparisonMonth.value && !comparisonMonth.disabled;
        submitBtn.disabled = !allValid;
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Year select change handlers
        document.getElementById('draftYear').addEventListener('change', function() {
            loadDraftMonths(this.value);
        });

        document.getElementById('comparisonYear').addEventListener('change', function() {
            loadApprovedMonths(this.value);
        });

        // Month select change handlers
        document.getElementById('draftMonth').addEventListener('change', updateSubmitButton);
        document.getElementById('comparisonMonth').addEventListener('change', updateSubmitButton);

        // Load months when modal opens
        document.getElementById('periodSelectionModal').addEventListener('show.bs.modal', function() {
            loadDraftMonths(document.getElementById('draftYear').value);
            loadApprovedMonths(document.getElementById('comparisonYear').value);
        });

        @if (Model == null)
        {
            <text>
            var modal = new bootstrap.Modal(document.getElementById('periodSelectionModal'));
            modal.show();
            </text>
        }
    });
</script>
}
