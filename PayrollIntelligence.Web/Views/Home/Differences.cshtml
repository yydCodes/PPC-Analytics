@model PayrollIntelligence.Core.KeyDifferencesResult?

@{
    ViewData["Title"] = "Detailed Changes";
    var currentYear = DateTime.Now.Year;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Detailed Changes</li>
        </ol>
    </nav>

    <!-- Selection Modal -->
    <div class="modal fade" id="periodSelectionModal" tabindex="-1" aria-labelledby="periodSelectionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="periodSelectionModalLabel"><i class="fas fa-search-plus"></i> Select Payroll Periods to Compare</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" id="differencesForm">
                    <div class="modal-body">
                        <div class="row">
                            <!-- Draft Payroll (Status 0) - Current -->
                            <div class="col-md-6">
                                <div class="card border-primary h-100">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0"><i class="fas fa-file-alt"></i> Draft Payroll (Current)</h6>
                                        <small class="opacity-75">Status: Draft (0)</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Year</label>
                                            <select class="form-control" name="draftYear" id="draftYear" required>
                                                @for (int y = currentYear; y >= 2022; y--)
                                                {
                                                    <option value="@y">@y</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Month</label>
                                            <select class="form-control" name="draftMonth" id="draftMonth" required disabled>
                                                <option value="">Loading...</option>
                                            </select>
                                            <div class="no-draft-message text-danger mt-1" style="display:none;">
                                                <small><i class="fas fa-exclamation-circle"></i> No draft payroll available.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Approved Payroll (Status 2) - Previous -->
                            <div class="col-md-6">
                                <div class="card border-success h-100">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0"><i class="fas fa-check-circle"></i> Approved Payroll (Previous)</h6>
                                        <small class="opacity-75">Status: Approved (2)</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Year</label>
                                            <select class="form-control" name="comparisonYear" id="comparisonYear" required>
                                                @for (int y = currentYear; y >= 2022; y--)
                                                {
                                                    <option value="@y">@y</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Month</label>
                                            <select class="form-control" name="comparisonMonth" id="comparisonMonth" required disabled>
                                                <option value="">Loading...</option>
                                            </select>
                                            <div class="no-approved-message text-danger mt-1" style="display:none;">
                                                <small><i class="fas fa-exclamation-circle"></i> No approved payroll available.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3 mb-0">
                            <small><i class="fas fa-info-circle"></i> Identify key differences in your <strong>draft payroll</strong> (current) compared to a selected <strong>approved payroll</strong> (previous).</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success" id="submitBtn" disabled>
                            <i class="fas fa-search-plus"></i> Find Differences
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-search-plus"></i> Detailed Changes</h4>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#periodSelectionModal">
                        <i class="fas fa-cog"></i> Change Periods
                    </button>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.DraftPeriod) && !string.IsNullOrEmpty(ViewBag.ComparisonPeriod))
                    {
                        <div class="alert alert-info mb-3">
                            <strong><i class="fas fa-file-alt"></i> Draft:</strong> @ViewBag.DraftPeriod
                            <span class="mx-3">→</span>
                            <strong><i class="fas fa-check-circle"></i> Compared against:</strong> @ViewBag.ComparisonPeriod (Approved)
                        </div>
                        
                        <!-- Page Context Help -->
                        <div class="alert alert-light border mb-4">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <strong>What you're looking at:</strong> This page highlights meaningful differences between your draft payroll and the last approved payroll. 
                            It's designed for payroll admins and finance reviewers who need to verify changes before approval. 
                            <strong>Start with the Attention Items</strong> if any are flagged, then review the Change Groups for context.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5><i class="fas fa-exclamation-triangle"></i> Analysis Error</h5>
                            <p class="mb-0">@ViewBag.Error</p>
                        </div>
                    }
                    else if (Model != null)
                    {
                        var confidenceClass = Model.confidence_level switch
                        {
                            "high" => "success",
                            "medium" => "warning",
                            _ => "secondary"
                        };

                        <!-- Payroll Overview Section -->
                        @if (Model.payroll_overview != null)
                        {
                            <div class="card mb-4 border-0 bg-light">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <h5 class="mb-0"><i class="fas fa-chart-bar text-success me-2"></i>Payroll Overview</h5>
                                        <span class="badge bg-@confidenceClass">
                                            <i class="fas fa-shield-alt me-1"></i>@Model.confidence_level.ToUpper() CONFIDENCE
                                        </span>
                                    </div>
                                    <p class="lead mb-3">@Model.payroll_overview.summary</p>
                                    
                                    <div class="row">
                                        <div class="col-md-6 col-lg-3 mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-users text-primary me-2"></i>
                                                <div>
                                                    <small class="text-muted">Headcount</small>
                                                    <div class="fw-semibold">@Model.payroll_overview.headcount_change</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-lg-3 mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-money-bill-wave text-success me-2"></i>
                                                <div>
                                                    <small class="text-muted">Gross Pay</small>
                                                    <div class="fw-semibold">@Model.payroll_overview.gross_pay_trend</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-lg-3 mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-wallet text-info me-2"></i>
                                                <div>
                                                    <small class="text-muted">Net Pay</small>
                                                    <div class="fw-semibold">@Model.payroll_overview.net_pay_trend</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-lg-3 mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-building text-warning me-2"></i>
                                                <div>
                                                    <small class="text-muted">Employer Cost</small>
                                                    <div class="fw-semibold">@Model.payroll_overview.employer_cost_trend</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Change Groups Section -->
                        @if (Model.change_groups.Any())
                        {
                            <h5 class="mb-3"><i class="fas fa-layer-group text-primary me-2"></i>Change Groups</h5>
                            <div class="row">
                                @foreach (var group in Model.change_groups)
                                {
                                    <div class="col-md-6 mb-4">
                                        <div class="card h-100 border-primary">
                                            <div class="card-header bg-primary text-white">
                                                <h6 class="mb-0"><i class="fas fa-folder-open me-2"></i>@group.group_title</h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">@group.description</p>
                                                
                                                @if (group.affected_employees.Any())
                                                {
                                                    <div class="mb-3">
                                                        <small class="text-muted"><strong>Affected Employees:</strong></small>
                                                        <div class="mt-1">
                                                            @foreach (var emp in group.affected_employees)
                                                            {
                                                                <span class="badge bg-light text-dark border me-1 mb-1">
                                                                    <i class="fas fa-user me-1"></i>@emp
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                
                                                <div class="alert alert-secondary mb-0 py-2">
                                                    <small><i class="fas fa-lightbulb me-1"></i><strong>Why it matters:</strong> @group.why_it_matters</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-4">
                                <i class="fas fa-check-circle me-2"></i>No significant grouped changes detected between the payroll periods.
                            </div>
                        }

                        <!-- Attention Items Section -->
                        @if (Model.attention_items.Any())
                        {
                            <h5 class="mb-3"><i class="fas fa-exclamation-triangle text-warning me-2"></i>Attention Items</h5>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-warning">
                                        <tr>
                                            <th style="width: 20%;"><i class="fas fa-user me-1"></i>Employee</th>
                                            <th style="width: 30%;">Issue</th>
                                            <th style="width: 50%;">Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.attention_items)
                                        {
                                            <tr>
                                                <td><strong>@item.employee</strong></td>
                                                <td><span class="badge bg-warning text-dark">@item.issue</span></td>
                                                <td>@item.reason</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <!-- Suggested Review Actions -->
                        @if (Model.change_groups.Any() || Model.attention_items.Any())
                        {
                            <div class="card mt-4 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Suggested Next Steps</h6>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-3">These are optional review actions to consider before approval:</p>
                                    <ul class="list-group list-group-flush">
                                        @if (Model.attention_items.Any())
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-warning text-dark me-3 mt-1">1</span>
                                                <div>
                                                    <strong>Review flagged employees</strong>
                                                    <p class="mb-0 text-muted small">Confirm the @Model.attention_items.Count attention item(s) listed above are expected or have valid explanations.</p>
                                                </div>
                                            </li>
                                        }
                                        @if (Model.change_groups.Any(g => g.group_title.Contains("Leave")))
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-info text-white me-3 mt-1">@(Model.attention_items.Any() ? "2" : "1")</span>
                                                <div>
                                                    <strong>Cross-check leave records</strong>
                                                    <p class="mb-0 text-muted small">Verify leave-related changes match HR leave approval records.</p>
                                                </div>
                                            </li>
                                        }
                                        @if (Model.change_groups.Any(g => g.group_title.Contains("New") || g.group_title.Contains("Removed")))
                                        {
                                            <li class="list-group-item d-flex align-items-start">
                                                <span class="badge bg-secondary me-3 mt-1">@(Model.attention_items.Any() ? (Model.change_groups.Any(g => g.group_title.Contains("Leave")) ? "3" : "2") : (Model.change_groups.Any(g => g.group_title.Contains("Leave")) ? "2" : "1"))</span>
                                                <div>
                                                    <strong>Confirm workforce changes</strong>
                                                    <p class="mb-0 text-muted small">Ensure new hires or departures are correctly reflected with proper onboarding/offboarding.</p>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            <h5><i class="fas fa-info-circle"></i> No Analysis Results</h5>
                            <p class="mb-0">Please select payroll periods to compare using the button above.</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="/" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Home</a>
                    <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#periodSelectionModal">
                        <i class="fas fa-sync"></i> New Analysis
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const draftMonthsCache = {};
    const approvedMonthsCache = {};

    async function loadDraftMonths(year) {
        const monthSelect = document.getElementById('draftMonth');
        const noPayrollMessage = document.querySelector('.no-draft-message');

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (draftMonthsCache[year]) {
            populateMonths(monthSelect, draftMonthsCache[year], noPayrollMessage, 'No draft payroll', 'first');
            updateSubmitButton();
            return;
        }

        try {
            const response = await fetch(`/Home/GetDraftMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                draftMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No draft payroll', 'first');
            } else {
                monthSelect.innerHTML = '<option value="">Error loading months</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error loading months</option>';
        }

        updateSubmitButton();
    }

    async function loadApprovedMonths(year) {
        const monthSelect = document.getElementById('comparisonMonth');
        const noPayrollMessage = document.querySelector('.no-approved-message');

        monthSelect.innerHTML = '<option value="">Loading...</option>';
        monthSelect.disabled = true;
        noPayrollMessage.style.display = 'none';

        if (approvedMonthsCache[year]) {
            populateMonths(monthSelect, approvedMonthsCache[year], noPayrollMessage, 'No approved payroll', 'latest');
            updateSubmitButton();
            return;
        }

        try {
            const response = await fetch(`/Home/GetApprovedMonths?year=${year}`);
            const data = await response.json();

            if (data.success) {
                approvedMonthsCache[year] = data.months;
                populateMonths(monthSelect, data.months, noPayrollMessage, 'No approved payroll', 'latest');
            } else {
                monthSelect.innerHTML = '<option value="">Error loading months</option>';
            }
        } catch (error) {
            monthSelect.innerHTML = '<option value="">Error loading months</option>';
        }

        updateSubmitButton();
    }

    // Populate month dropdown
    // defaultSelection: 'first' = select first/earliest month, 'latest' = select last/latest month
    function populateMonths(monthSelect, months, noPayrollMessage, noDataMessage, defaultSelection = 'latest') {
        monthSelect.innerHTML = '';

        if (months.length === 0) {
            monthSelect.innerHTML = `<option value="">${noDataMessage}</option>`;
            monthSelect.disabled = true;
            noPayrollMessage.style.display = 'block';
        } else {
            months.forEach((month, index) => {
                const option = document.createElement('option');
                option.value = month.value;
                option.textContent = month.name;
                
                // Select first or latest month based on defaultSelection parameter
                if (defaultSelection === 'first' && index === 0) {
                    option.selected = true;
                } else if (defaultSelection === 'latest' && index === months.length - 1) {
                    option.selected = true;
                }
                
                monthSelect.appendChild(option);
            });
            monthSelect.disabled = false;
            noPayrollMessage.style.display = 'none';
        }
    }

    function updateSubmitButton() {
        const submitBtn = document.getElementById('submitBtn');
        const draftMonth = document.getElementById('draftMonth');
        const comparisonMonth = document.getElementById('comparisonMonth');

        const allValid = draftMonth.value && !draftMonth.disabled &&
                         comparisonMonth.value && !comparisonMonth.disabled;
        submitBtn.disabled = !allValid;
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Year select change handlers
        document.getElementById('draftYear').addEventListener('change', function() {
            loadDraftMonths(this.value);
        });

        document.getElementById('comparisonYear').addEventListener('change', function() {
            loadApprovedMonths(this.value);
        });

        // Month select change handlers
        document.getElementById('draftMonth').addEventListener('change', updateSubmitButton);
        document.getElementById('comparisonMonth').addEventListener('change', updateSubmitButton);

        // Load months when modal opens
        document.getElementById('periodSelectionModal').addEventListener('show.bs.modal', function() {
            loadDraftMonths(document.getElementById('draftYear').value);
            loadApprovedMonths(document.getElementById('comparisonYear').value);
        });

        @if (Model == null)
        {
            <text>
            var modal = new bootstrap.Modal(document.getElementById('periodSelectionModal'));
            modal.show();
            </text>
        }
    });
</script>
}
